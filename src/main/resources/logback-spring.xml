<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Honor Spring Boot's logging.* properties (level, file path, etc.) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        Plain-text console output for local tracing: JSON was hard to read/grep
        directly. Correlation fields (request_id, merchant_id, user_name) still
        come through inline via MDC since RequestResponseLoggingFilter sets them.
    -->
    <appender name="TEXT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - reqId=%X{request_id} merchant=%X{merchant_id} user=%X{user_name} :: %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!--
        Wrap console output in an AsyncAppender. log.info(...) calls enqueue and
        return; a background thread drains the queue. Keeps slow Docker
        log drivers from blocking request threads.
    -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="TEXT_CONSOLE"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>
